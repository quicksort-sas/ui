{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "quicksort",
  "homepage": "https://quicksort.design/components",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "Quicksort theme",
      "description": "Ink, paper, stone and the lime pivot as shadcn tokens, Host Grotesk and Martian Mono, light and dark.",
      "dependencies": [
        "@fontsource-variable/host-grotesk",
        "@fontsource-variable/martian-mono",
        "tw-animate-css"
      ],
      "cssVars": {
        "theme": {
          "font-sans": "\"Host Grotesk Variable\", \"Host Grotesk\", ui-sans-serif, system-ui, sans-serif",
          "font-heading": "var(--font-sans)",
          "font-mono": "\"Martian Mono Variable\", \"Martian Mono\", ui-monospace, monospace",
          "color-pivot": "var(--pivot)",
          "color-pivot-foreground": "var(--pivot-foreground)",
          "color-faint": "var(--faint)",
          "color-success": "var(--success)",
          "color-warning": "var(--warning)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "radius-sm": "calc(var(--radius) * 0.6)",
          "radius-md": "calc(var(--radius) * 0.8)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) * 1.4)",
          "radius-2xl": "calc(var(--radius) * 1.8)",
          "radius-3xl": "calc(var(--radius) * 2.2)",
          "radius-4xl": "calc(var(--radius) * 2.6)"
        },
        "light": {
          "background": "#f3f0e8",
          "foreground": "#141414",
          "card": "#faf8f3",
          "card-foreground": "#141414",
          "popover": "#faf8f3",
          "popover-foreground": "#141414",
          "primary": "#141414",
          "primary-foreground": "#faf8f3",
          "secondary": "#e9e5db",
          "secondary-foreground": "#141414",
          "muted": "#ebe7de",
          "muted-foreground": "#55504a",
          "accent": "#e4e0d6",
          "accent-foreground": "#141414",
          "destructive": "#b42318",
          "destructive-foreground": "#faf8f3",
          "success": "#2f6b3a",
          "warning": "#9a5b00",
          "border": "#e4e1db",
          "input": "#8a857d",
          "ring": "#141414",
          "pivot": "#ccff00",
          "pivot-foreground": "#141414",
          "faint": "#736c61",
          "chart-1": "#141414",
          "chart-2": "#736c61",
          "chart-3": "#b8b4ad",
          "chart-4": "#ccff00",
          "chart-5": "#55504a",
          "radius": "0.125rem",
          "sidebar": "#faf8f3",
          "sidebar-foreground": "#141414",
          "sidebar-primary": "#141414",
          "sidebar-primary-foreground": "#faf8f3",
          "sidebar-accent": "#ebe7de",
          "sidebar-accent-foreground": "#141414",
          "sidebar-border": "#e4e1db",
          "sidebar-ring": "#141414"
        },
        "dark": {
          "background": "#141413",
          "foreground": "#ece8df",
          "card": "#1d1d1b",
          "card-foreground": "#ece8df",
          "popover": "#1d1d1b",
          "popover-foreground": "#ece8df",
          "primary": "#ece8df",
          "primary-foreground": "#141413",
          "secondary": "#262624",
          "secondary-foreground": "#ece8df",
          "muted": "#222220",
          "muted-foreground": "#b5b0a7",
          "accent": "#2a2a28",
          "accent-foreground": "#ece8df",
          "destructive": "#f2765f",
          "destructive-foreground": "#141413",
          "success": "#7fc28b",
          "warning": "#e0a443",
          "border": "#2a2927",
          "input": "#76726b",
          "ring": "#ece8df",
          "pivot": "#ccff00",
          "pivot-foreground": "#141414",
          "faint": "#918c84",
          "chart-1": "#ece8df",
          "chart-2": "#918c84",
          "chart-3": "#3f3d3a",
          "chart-4": "#ccff00",
          "chart-5": "#b5b0a7",
          "sidebar": "#1a1a18",
          "sidebar-foreground": "#ece8df",
          "sidebar-primary": "#ece8df",
          "sidebar-primary-foreground": "#141413",
          "sidebar-accent": "#262624",
          "sidebar-accent-foreground": "#ece8df",
          "sidebar-border": "#2a2927",
          "sidebar-ring": "#ece8df"
        }
      },
      "css": {
        "@import \"@fontsource-variable/host-grotesk\"": {},
        "@import \"@fontsource-variable/martian-mono\"": {},
        "@layer base": {
          "html": {
            "@apply font-sans": {},
            "-webkit-font-smoothing": "antialiased"
          },
          "::selection": {
            "background": "var(--pivot)",
            "color": "var(--pivot-foreground)"
          }
        },
        "@utility label-mono": {
          "font-family": "var(--font-mono)",
          "font-size": "11px",
          "line-height": "1.2",
          "letter-spacing": ".06em",
          "text-transform": "uppercase",
          "color": "var(--muted-foreground)"
        },
        "@utility num": {
          "font-family": "var(--font-mono)",
          "font-variant-numeric": "tabular-nums",
          "letter-spacing": "-0.02em"
        }
      }
    },
